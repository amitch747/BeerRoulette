<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Mood buff -->
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThoughtDef[defName="Inebriated"]/stages</xpath>
        <value>
            <li>
                <label>Addrenalin Rush</label>
                <description>What a rush!</description>
                <baseMoodEffect>30</baseMoodEffect>
            </li>
        </value>
    </Operation>

    <!-- Melee Explosion 1/6 -->

    <!-- Drink Explosion 1/6 -->

    <!-- Explodes on destruction -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Beer"]/comps</xpath>
        <value>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>1.9</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
                <startWickHitPointsPercent>1.0</startWickHitPointsPercent>
                <wickTicks>10~20</wickTicks>
            </li>
        </value>
    </Operation>

</Patch>
