<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Mood buff -->
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThoughtDef[defName="Inebriated"]/stages</xpath>
        <value>
            <stages>
                <li>
                    <label>adrenaline rush</label>
                    <description>What a rush!</description>
                    <baseMoodEffect>50</baseMoodEffect>
                </li>
            </stages>
        </value>
    </Operation>



    <!-- Drink Explosion 1/6 -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Beer"]/comps</xpath>
        <value>
            <li Class="BeerRoulette.CompProperties_BeerRoulette">
                <explosionChance>0.1</explosionChance>
                <explosionRadius>0.9</explosionRadius>
            </li>
        </value>
    </Operation>


    <Operation Class="PatchOperationReplace">
        <!--Replacing capacity of bottle on Beer with custom capacity-->
        <xpath>/Defs/ThingDef[defName="Beer"]/tools/li[label="bottle"]/capacities</xpath>
        <value>
            <capacities>
                <li>BeerRouletteSmash</li>
            </capacities>
        </value>
    </Operation>


</Patch>
