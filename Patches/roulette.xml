<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Mood buff -->
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThoughtDef[defName="Inebriated"]/stages</xpath>
        <value>
            <stages>
                <li>
                    <label>adrenaline rush</label>
                    <description>What a rush!</description>
                    <baseMoodEffect>60</baseMoodEffect>
                </li>
            </stages>
        </value>
    </Operation>



    <!-- Drink Explosion 1/6 -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Beer"]/comps</xpath>
        <value>
            <li Class="BeerRoulette.CompProperties_BeerRoulette">
                <explosionChance>0.1667</explosionChance>
                <explosionRadius>1.9</explosionRadius>
            </li>
        </value>
    </Operation>

</Patch>
